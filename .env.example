# Billforce server settings (all optional). Copy to .env for local use.

# HTTP port
PORT=3000

# Folder for every business's database, logins and backups. Keep it on a persistent disk and back it up.
BILLFORCE_DATA_DIR=./data

# "closed" stops new businesses from registering (existing businesses can still sign in).
BILLFORCE_REGISTRATION=open

# Behind a load balancer / Cloud Run, set to 1 so sign-in rate limits see the real client address.
# TRUST_PROXY=1

# Largest backup file (MB) that can be uploaded for a restore.
# BILLFORCE_MAX_UPLOAD_MB=200

# Optional: Supabase project used by the browser's "Sign in with Supabase" option.
# Each business sets its own cloud copy in Settings > Supabase Cloud Sync.
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-key"
